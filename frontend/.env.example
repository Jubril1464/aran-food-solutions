# Point this at a running backend API. Ignored when VITE_DEMO_MODE=true.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo mode: serve the whole API from sample data inside the browser, with no
# backend and no database at all. Everything works - catalogue, cart, minimum
# order quantities, checkout, the mock payment, order tracking, and the admin
# screens - against data held in localStorage.
#
# This is what the hosted demo build uses. Set it to false (or remove it) to
# talk to a real API again; nothing else in the app changes.
VITE_DEMO_MODE=false
