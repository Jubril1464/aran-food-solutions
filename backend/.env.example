# Copy to .env and fill in real values for anything beyond local dev.
#
# The AWS/Lambda deployment does NOT use this file: infra/terraform/lambda.tf
# sets the same variables as Lambda environment variables. Anything added here
# that production needs has to be added there too.

APP_NAME="Agric Procurement Platform"
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://agric:agric@postgres:5432/agric
# Require TLS to the database. Left off locally; the deployment sets it to true
# because RDS is configured with rds.force_ssl=1.
DB_SSL_REQUIRED=false
REDIS_URL=redis://redis:6379/0

# Notification queue: "redis" (local/docker-compose, consumed by the arq worker)
# or "sqs" (the Lambda deployment, consumed by the worker function).
QUEUE_BACKEND=redis
SQS_NOTIFICATION_QUEUE_URL=

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173"]

# SameSite policy for the refresh-token cookie. "lax" is correct when the API
# and frontend share an origin, as they do locally. The AWS deployment serves
# them from different domains (CloudFront vs API Gateway), so it sets "none" —
# a Lax cookie is never sent cross-site and silent refresh would always fail.
# "none" forces Secure, so it only works over HTTPS.
REFRESH_COOKIE_SAMESITE=lax

# Storage: "local" (default, saved to ./storage/uploads) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
LOCAL_STORAGE_PUBLIC_URL=/static/uploads
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
# Static S3 credentials, for something like a local MinIO. Leave BLANK on AWS:
# Lambda injects the execution role's credentials into the environment and
# boto3 picks them up itself. These are deliberately not named
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY so they can't shadow those — see the
# note in app/core/config.py.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Largest accepted image upload. Keep at or below ~4 MB while running on
# Lambda: its synchronous payload limit is 6 MB and the request body arrives
# base64-encoded, so bigger uploads are rejected by the platform before the
# app sees them.
MAX_UPLOAD_SIZE_MB=4

# Email: "console" (default, logs instead of sending — see docker compose logs backend)
# or "smtp" with the settings below.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@agric.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Leave blank to run Paystack in mock mode (checkout/payment flow works end-to-end
# without a real account — useful for local dev and demos). Set a real secret key
# to integrate with the actual Paystack API.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

FRONTEND_URL=http://localhost:5173

# First-admin bootstrap, read only by app/seed_handler.py (the AWS deployment
# runs it as a one-off Lambda; locally you can run the same handler by hand).
# /auth/register only ever creates customers, so this is the only route to an
# administrator account.
SEED_ADMIN_EMAIL=admin@agric.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=+2348000000000
SEED_DEMO_DATA=true

DELIVERY_FEE=1000.0
SERVICE_FEE_PERCENT=2.5
