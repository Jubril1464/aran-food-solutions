# Copy to .env and fill in real values for anything beyond local dev.
#
# The hosted deployment does NOT read this file - Render sets the same variables
# as service environment variables. Anything added here that the deployment needs
# has to be added to render.yaml (or the Render dashboard) too.

APP_NAME="Agric Procurement Platform"
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://agric:agric@postgres:5432/agric
# Require TLS to the database. Left off for a local Postgres. Managed providers
# (Neon, Supabase, ...) require it - and if the connection string they give you
# already says "?sslmode=require", that is detected automatically, so you can
# paste it verbatim.
DB_SSL_REQUIRED=false
REDIS_URL=redis://redis:6379/0

# Notification delivery: "in_process" (a background task in the API process -
# the default, and what the hosted deployment uses, since it needs no second
# service) or "redis" (arq queue + the separate worker process that
# docker-compose runs). Notifications are never sent on the request path either
# way.
QUEUE_BACKEND=in_process

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173"]

# SameSite policy for the refresh-token cookie. "lax" is correct when the API
# and frontend share an origin, as they do locally. The hosted deployment serves
# them from two different hostnames, so it sets "none" - a Lax cookie is never
# sent cross-site and silent refresh would always fail. "none" forces Secure, so
# it only works over HTTPS.
REFRESH_COOKIE_SAMESITE=lax

# Storage: "local" (default, saved to ./storage/uploads) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
LOCAL_STORAGE_PUBLIC_URL=/static/uploads
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
# Credentials for any S3-compatible provider (Supabase Storage, Backblaze B2,
# Cloudflare R2, MinIO). Deliberately not named AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, so they can never shadow credentials a host injects into
# the environment for its own purposes - see the note in app/core/config.py.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Any S3-compatible provider works (Supabase Storage, Backblaze B2, R2, MinIO) -
# set S3_ENDPOINT_URL to theirs. With STORAGE_BACKEND=local on a host without a
# persistent disk, uploaded images are lost on the next deploy.

# Largest accepted image upload, rejected with a clear 413 rather than by
# whatever proxy sits in front of the app with an opaque error.
MAX_UPLOAD_SIZE_MB=4

# Email: "console" (default, logs instead of sending — see docker compose logs backend)
# or "smtp" with the settings below.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@agric.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Leave blank to run Paystack in mock mode (checkout/payment flow works end-to-end
# without a real account — useful for local dev and demos). Set a real secret key
# to integrate with the actual Paystack API.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

FRONTEND_URL=http://localhost:5173

# First-admin bootstrap, read only by app/seed.py (`python -m app.seed`, which
# the deploy runs on every start - it is idempotent). /auth/register only ever
# creates customers, so this is the only route to an administrator account.
# Must not be a .local/.test address - those are special-use names that email
# validation rejects, so such an admin could never log in.
SEED_ADMIN_EMAIL=admin@agric.example
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=+2348000000000
SEED_DEMO_DATA=true

DELIVERY_FEE=1000.0
SERVICE_FEE_PERCENT=2.5
